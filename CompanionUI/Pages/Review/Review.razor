@page "/review"
@* No prerender: it ran OnInitializedAsync twice (prerender + interactive), loading the list,
   the first entry and its page image twice. *@
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Text.Json
@using Microsoft.AspNetCore.Authorization
@using DndMcpAICsharpFun.Domain.Entities
@using DndMcpAICsharpFun.Features.Admin.Review
@using DndMcpAICsharpFun.Features.Auth
@using DndMcpAICsharpFun.Features.Ingestion.Programmatic
@attribute [Authorize(Policy = AuthPolicies.Admin)]
@inject EntityReviewService ReviewSvc
@inject DndMcpAICsharpFun.Features.Ingestion.EntityExtraction.EntitySchemaProvider SchemaProvider

<PageTitle>Review</PageTitle>

<div class="review-page">
    <h1>Entity review</h1>
    @if (_toast is not null)
    {
        <div class="toast @(_toastIsError ? "toast--error" : "")" role="@(_toastIsError ? "alert" : "status")">@_toast</div>
    }

    <div class="review-layout">
        <aside class="review-list card">
            <div class="review-filters">
                <select aria-label="Book" value="@_book" @onchange="OnBookChanged">
                    <option value="">All books</option>
                    @foreach (var b in _books)
                    {
                        <option value="@b">@b</option>
                    }
                </select>
                <select aria-label="Type" value="@_type" @onchange="OnTypeChanged">
                    <option value="@AllButLore">All but Lore (@_typeCounts.Where(kv => kv.Key != nameof(EntityType.Lore)).Sum(kv => kv.Value))</option>
                    <option value="">All types (@_typeCounts.Values.Sum())</option>
                    @foreach (var (t, n) in _typeCounts.OrderByDescending(kv => kv.Value).ThenBy(kv => kv.Key))
                    {
                        <option value="@t">@t (@n)</option>
                    }
                </select>
                <label class="review-toggle">
                    <input type="checkbox" checked="@_flaggedOnly" @onchange="OnFlaggedChanged" />
                    Flagged only
                </label>
            </div>

            @if (_items is null)
            {
                <p class="muted">Loading...</p>
            }
            else if (_items.Count == 0)
            {
                <p class="muted">Nothing to review.</p>
            }
            else
            {
                <ul class="review-items">
                    @foreach (var i in _items)
                    {
                        <li>
                            <button type="button" class="review-item @(i.Id == _selectedId ? "selected" : "")"
                                    @onclick="() => SelectAsync(i.Id)">
                                <span class="review-item-name">@i.Name</span>
                                <span class="review-item-meta">
                                    <span class="chip">@i.Type</span>
                                    <span class="muted">@i.BookSlug@(i.Page is null ? "" : $" p.{i.Page}")</span>
                                    @if (i.Flagged)
                                    {
                                        <span class="badge review-flag">flagged</span>
                                    }
                                </span>
                            </button>
                        </li>
                    }
                </ul>
            }
        </aside>

        <section class="review-detail">
            @if (_entity is null)
            {
                <p class="muted">Select an entity on the left.</p>
            }
            else
            {
                <div class="card review-entity @(_busy ? "is-busy" : "")">
                    @if (_busy)
                    {
                        <div class="review-busy" role="status"><span class="spinner"></span>@_busyLabel</div>
                    }
                    <header class="review-entity-head">
                        <h2>@_entity.Name</h2>
                        <span class="chip">@_entity.Type</span>
                        <span class="badge">@_entity.Disposition</span>
                        <span class="muted data">@_entity.Id</span>
                    </header>

                    @if (_checks.Count > 0)
                    {
                        <ul class="review-checks">
                            @foreach (var c in _checks)
                            {
                                <li class="review-check @(c.Passed ? "pass" : "fail")">
                                    <span class="review-check-name data">@c.Name</span>
                                    <span>@(c.Passed ? "repaired" : "failed"): @c.Reason</span>
                                </li>
                            }
                        </ul>
                    }

                    <div class="review-fields">
                        @foreach (var key in _editOrder)
                        {
                            var k = key;
                            var overridden = _overrides.Any(o => o.Field == k);
                            <div class="review-field">
                                <label for="f-@k" class="data">
                                    @k
                                    @if (overridden)
                                    {
                                        <span class="badge">overridden</span>
                                        <button type="button" class="btn btn--danger review-remove"
                                                @onclick="() => RemoveAsync(k)">Remove override</button>
                                    }
                                </label>
                                @if (_hints.TryGetValue(k, out var hint))
                                {
                                    <div class="review-hint muted">@hint</div>
                                }
                                @if (_examples.TryGetValue(k, out var example))
                                {
                                    <div class="review-hint muted">e.g. <code>@example</code></div>
                                }
                                <textarea id="f-@k" class="data" rows="@RowsFor(k, _edits[k])"
                                          @bind="_edits[k]"></textarea>
                            </div>
                        }
                    </div>

                    <div class="review-actions">
                        <input type="text" placeholder="Reason (required)" aria-label="Reason"
                               @bind="_reason" />
                        <button type="button" class="btn btn--primary" disabled="@_busy" @onclick="SaveAsync">@(_busy ? "Working…" : "Save override")</button>
                        @if (_entity.Disposition != EntityDisposition.Accepted || _entity.NeedsReview)
                        {
                            <button type="button" class="btn btn--ghost" disabled="@_busy" @onclick="ApproveAsync">@(_busy ? "Working…" : "Approve")</button>
                        }
                    </div>
                </div>

                <div class="card review-source">
                    @if (_pages.Count == 0)
                    {
                        <p class="muted">No source page recorded for this entity.</p>
                    }
                    else
                    {
                        <div class="review-pages">
                            @foreach (var p in _pages)
                            {
                                var pg = p;
                                <button type="button" class="btn @(pg == _imagePage ? "btn--primary" : "btn--ghost")"
                                        @onclick="() => ShowPageAsync(pg)">Page @pg</button>
                            }
                        </div>
                    }

                    @if (_imageLoading)
                    {
                        <div class="review-busy review-busy--inline" role="status"><span class="spinner"></span>Loading page @_imagePage…</div>
                    }
                    @if (_imageNote is not null)
                    {
                        <p class="muted">@_imageNote</p>
                    }
                    @if (_imageUri is not null)
                    {
                        <div class="review-image-wrap">
                            <img src="@_imageUri" alt="Book page @_imagePage" />
                            @foreach (var b in _boxes)
                            {
                                <div class="review-box" style="@b"></div>
                            }
                        </div>
                    }
                </div>
            }
        </section>
    </div>
</div>

@code {
    private List<string> _books = [];
    private string _book = "";
    private bool _flaggedOnly = true;
    // Lore is reviewed last: its text also reaches the chat as book passages (search_lore), so a flagged Lore entry costs
    // little; structured types feed the tools directly.
    internal const string AllButLore = "!Lore";
    private string _type = AllButLore;
    private Dictionary<string, int> _typeCounts = new();
    private IReadOnlyList<ReviewListItem>? _items;

    private string? _selectedId;
    private EntityEnvelope? _entity;
    private IReadOnlyList<EntityCheck> _checks = [];
    private IReadOnlyList<FieldOverride> _overrides = [];
    private readonly Dictionary<string, string> _edits = new();
    private readonly Dictionary<string, string> _originals = new();
    private List<string> _editOrder = [];
    private List<int> _pages = [];
    private int _imagePage;
    private string? _imageUri;
    private List<string> _boxes = [];
    private string? _imageNote;

    private string _reason = "";
    private string? _message;
    private string? _error;
    private bool _busy;
    private string _busyLabel = "Working…";
    private bool _imageLoading;

    protected override async Task OnInitializedAsync()
    {
        _books = (await ReviewSvc.ListBooksAsync(default)).ToList();
        await ReloadListAsync();
        await SelectFirstAsync();
    }

    // Open the first entry so reviewing starts without a click.
    private async Task SelectFirstAsync()
    {
        if (_items is { Count: > 0 } && _items.All(i => i.Id != _selectedId))
            await SelectAsync(_items[0].Id);
    }

    private async Task ReloadListAsync()
    {
        var all = await ReviewSvc.ListAsync(_book == "" ? null : _book, _flaggedOnly, default);
        _typeCounts = all.GroupBy(i => i.Type.ToString()).ToDictionary(g => g.Key, g => g.Count());
        if (_type is not ("" or AllButLore) && !_typeCounts.ContainsKey(_type)) _type = "";
        _items = FilterByType(all, _type);
    }

    private Dictionary<EntityType, JsonElement>? _schemas;
    private readonly Dictionary<string, string> _hints = new();
    private IReadOnlyDictionary<string, string> _examples = new Dictionary<string, string>();

    // Examples come from accepted entities in every book: the first load parses all files, so it runs after the
    // entry is on screen and fills the hints in when ready (unless another entry was opened meanwhile).
    private async Task LoadExamplesAsync(EntityType type, string forId)
    {
        try
        {
            var byField = await ReviewSvc.GetFieldExamplesAsync(type, default);
            if (_entity?.Id != forId) return;
            _examples = byField.ToDictionary(kv => "fields." + kv.Key, kv => kv.Value);
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception)
        {
            // hints are a convenience; the entry stays editable without them
        }
    }

    // "confidence" is injected into the schemas for the LLM extractor only; it is not a book field.
    internal static IEnumerable<string> MissingSchemaFields(JsonElement fields, JsonElement schema)
    {
        if (!schema.TryGetProperty("properties", out var props) || props.ValueKind != JsonValueKind.Object) yield break;
        foreach (var p in props.EnumerateObject())
        {
            if (p.Name == "confidence") continue;
            if (fields.ValueKind == JsonValueKind.Object && fields.TryGetProperty(p.Name, out _)) continue;
            yield return p.Name;
        }
    }

    internal static IReadOnlyList<ReviewListItem> FilterByType(IReadOnlyList<ReviewListItem> items, string type) =>
        type switch
        {
            "" => items,
            AllButLore => items.Where(i => i.Type != EntityType.Lore).ToList(),
            _ => items.Where(i => i.Type.ToString() == type).ToList(),
        };

    internal static string TypeLabel(string type) => type == AllButLore ? "all but Lore" : type;

    private async Task OnTypeChanged(ChangeEventArgs e)
    {
        _type = e.Value?.ToString() ?? "";
        await ReloadListAsync();
        await SelectFirstAsync();
    }

    private async Task OnBookChanged(ChangeEventArgs e)
    {
        _book = e.Value?.ToString() ?? "";
        await ReloadListAsync();
        await SelectFirstAsync();
    }

    private async Task OnFlaggedChanged(ChangeEventArgs e)
    {
        _flaggedOnly = e.Value is true;
        await ReloadListAsync();
        await SelectFirstAsync();
    }

    private async Task SelectAsync(string id)
    {
        _message = _error = null;
        _reason = "";
        _selectedId = id;
        await LoadEntityAsync();
        if (_pages.Count > 0) await ShowPageAsync(_pages[0]);
    }

    private async Task LoadEntityAsync()
    {
        _entity = _selectedId is null ? null : await ReviewSvc.GetAsync(_selectedId, default);
        if (_entity is null) { _checks = []; _overrides = []; _pages = []; _imageUri = null; return; }

        _checks = EntityReviewService.VisibleChecks(_entity);
        _overrides = await ReviewSvc.GetOverridesAsync(_entity.Id, default);

        _edits.Clear();
        _originals.Clear();
        _editOrder = ["name", "canonicalText"];
        // name and canonicalText are edited as plain text (real line breaks, no JSON escapes);
        // every fields.* value stays JSON, written without \uXXXX escapes so it reads as printed.
        _originals["name"] = _entity.Name;
        _originals["canonicalText"] = _entity.CanonicalText ?? "";
        if (_entity.Fields.ValueKind == JsonValueKind.Object)
        {
            foreach (var p in _entity.Fields.EnumerateObject())
            {
                var key = "fields." + p.Name;
                _editOrder.Add(key);
                _originals[key] = JsonSerializer.Serialize(p.Value, ReadableJson);
            }
        }
        // Fields the type's schema allows but the extraction left out are shown empty (null), so a missing
        // value (an item's cost, a weight) can be filled in; an untouched empty field is never saved.
        _schemas ??= SchemaProvider.LoadSchemas();
        _hints.Clear();
        _examples = new Dictionary<string, string>();
        if (_schemas.TryGetValue(_entity.Type, out var schema)
            && schema.TryGetProperty("properties", out var props) && props.ValueKind == JsonValueKind.Object)
        {
            foreach (var p in props.EnumerateObject())
                if (p.Name != "confidence") _hints["fields." + p.Name] = FieldHints.Describe(p.Value);
        }
        if (schema.ValueKind == JsonValueKind.Object)
        {
            foreach (var name in MissingSchemaFields(_entity.Fields, schema))
            {
                var key = "fields." + name;
                _editOrder.Add(key);
                _originals[key] = "null";
            }
        }
        foreach (var (k, v) in _originals) _edits[k] = v;
        // Started only once every edit box has its value: the first load yields, and a render may run then.
        _ = LoadExamplesAsync(_entity.Type, _entity.Id);

        _pages = (_entity.Provenance?.Pages.Select(p => p.Page) ?? [])
            .Concat(_entity.Page is { } onPage ? new[] { onPage } : Array.Empty<int>())
            .Distinct().OrderBy(p => p).ToList();
    }

    private async Task ShowPageAsync(int page)
    {
        if (_entity is null) return;
        _imagePage = page;
        _imageUri = null;
        _imageLoading = true;
        _imageNote = null;
        _boxes = [];
        try
        {
            _imageUri = await ReviewSvc.GetPageImageDataUriAsync(_entity.Id, page, default);
            if (EntityReviewService.TryGetPngSize(_imageUri, out var w, out var h))
            {
                var boxes = _entity.Provenance?.Pages.Where(p => p.Page == page).SelectMany(p => p.Boxes) ?? [];
                _boxes = boxes.Select(b => FormattableString.Invariant(
                    $"left:{b.X0 / w * 100:0.###}%;top:{b.Y0 / h * 100:0.###}%;width:{(b.X1 - b.X0) / w * 100:0.###}%;height:{(b.Y1 - b.Y0) / h * 100:0.###}%")).ToList();
            }
            else
            {
                _imageNote = "The page image is not a PNG, so its size is unknown and provenance boxes are not drawn.";
            }
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            ShowToast($"Could not load page {page}: {ex.Message}", error: true);
        }
        finally
        {
            _imageLoading = false;
        }
    }

    private async Task SaveAsync()
    {
        _busyLabel = "Saving…";
        await RunAsync(async () =>
        {
            var changed = _editOrder.Where(k => _edits[k] != _originals[k]).ToList();
            if (changed.Count == 0) throw new ArgumentException("Nothing changed.");
            // Parse every field first so one invalid field writes nothing.
            var parsed = new List<(string Field, JsonElement Value)>();
            foreach (var k in changed)
            {
                if (PlainTextKeys.Contains(k))
                {
                    parsed.Add((k, JsonSerializer.SerializeToElement(_edits[k])));
                    continue;
                }
                try { parsed.Add((k, JsonDocument.Parse(_edits[k]).RootElement.Clone())); }
                catch (JsonException) { throw new ArgumentException($"{k} is not valid JSON."); }
            }
            await ReviewSvc.OverrideManyAsync(_entity!.Id, parsed, _reason, default);
            _message = $"Saved {changed.Count} override(s).";
        });
    }

    private async Task ApproveAsync()
    {
        if (_entity is null || _busy) return;
        var approvedId = _entity.Id;
        var approvedName = _entity.Name;
        var index = _items?.ToList().FindIndex(i => i.Id == approvedId) ?? -1;
        var accepted = false;
        _busyLabel = "Approving…";
        await RunAsync(async () =>
        {
            var e = await ReviewSvc.ApproveAsync(approvedId, _reason, default);
            accepted = e.Disposition == EntityDisposition.Accepted;
            _message = accepted
                ? null
                : "Approval saved, but unresolved override problems still block acceptance - remove or fix those overrides.";
        });
        if (!accepted || _error is not null) return;

        ShowToast($"Approved {approvedName}");
        // Move on to the next entry: the approved one has left a flagged-only list, so the same index
        // is the next item; otherwise step past it.
        var next = NextAfterApprove(_items, approvedId, index);
        if (next is not null)
        {
            await SelectAsync(next);
            return;
        }
        // The filtered type is done: move on to the type with the most entries left.
        if (_type != "" && _items is { Count: 0 })
        {
            var done = _type;
            _type = NextType(_typeCounts, done);
            await ReloadListAsync();
            await SelectFirstAsync();
            ShowToast(_type == "" ? $"All {TypeLabel(done)} reviewed" : $"All {TypeLabel(done)} reviewed - showing {_type}");
        }
    }

    internal static string NextType(IReadOnlyDictionary<string, int> counts, string done) =>
        counts.Where(kv => kv.Key != done && kv.Value > 0)
            .OrderByDescending(kv => kv.Value).ThenBy(kv => kv.Key)
            .Select(kv => kv.Key).FirstOrDefault() ?? "";

    internal static string? NextAfterApprove(IReadOnlyList<ReviewListItem>? items, string approvedId, int index)
    {
        if (items is null || items.Count == 0) return null;
        var stillListed = items.ToList().FindIndex(i => i.Id == approvedId);
        var at = stillListed >= 0 ? stillListed + 1 : Math.Max(index, 0);
        return at < items.Count ? items[at].Id : null;
    }

    // Update the one changed row in place instead of re-reading every book file for the list.
    private void UpdateListItem()
    {
        if (_items is null || _entity is null) return;
        var list = _items.ToList();
        var at = list.FindIndex(i => i.Id == _entity.Id);
        if (at < 0) return;
        var flagged = _entity.Disposition != EntityDisposition.Accepted || _entity.NeedsReview;
        if (_flaggedOnly && !flagged)
        {
            var type = list[at].Type.ToString();
            list.RemoveAt(at);
            if (_typeCounts.TryGetValue(type, out var n))
            {
                if (n <= 1) _typeCounts.Remove(type);
                else _typeCounts[type] = n - 1;
            }
        }
        else list[at] = list[at] with { Name = _entity.Name, Flagged = flagged };
        _items = list;
    }

    private string? _toast;
    private CancellationTokenSource? _toastCts;

    private bool _toastIsError;

    // Every outcome (saved, approved, error) is a toast, so nothing is inserted above the columns
    // and the list, fields and page always start at the same height. Errors stay longer.
    private void ShowToast(string text, bool error = false)
    {
        _toast = text;
        _toastIsError = error;
        _toastCts?.Cancel();
        var cts = _toastCts = new CancellationTokenSource();
        _ = Task.Delay(error ? 8000 : 3000, cts.Token).ContinueWith(t =>
        {
            if (t.IsCanceled) return;
            _toast = null;
            _ = InvokeAsync(StateHasChanged);
        }, TaskScheduler.Default);
    }

    private Task RemoveAsync(string field)
    {
        _busyLabel = "Removing override…";
        return RemoveCoreAsync(field);
    }

    private Task RemoveCoreAsync(string field) => RunAsync(async () =>
    {
        await ReviewSvc.RemoveOverrideAsync(_entity!.Id, field, default);
        _message = $"Removed override at {field}.";
    });

    private async Task RunAsync(Func<Task> action)
    {
        if (_entity is null || _busy) return;
        _busy = true;
        _message = _error = null;
        try
        {
            await action();
            _reason = "";
            await LoadEntityAsync();
            UpdateListItem();
        }
        catch (ArgumentException ex)
        {
            _error = ex.Message;
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _error = $"Failed: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
        if (_error is not null) ShowToast(_error, error: true);
        else if (_message is not null) ShowToast(_message);
    }

    private static readonly HashSet<string> PlainTextKeys = ["name", "canonicalText"];

    private static readonly JsonSerializerOptions ReadableJson = new()
    {
        WriteIndented = true,
        Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping,
    };

    // Rows follow the text, counting long lines that wrap; the entry text gets far more room
    // than a field so a whole stat block or section reads without scrolling the box.
    internal static int RowsFor(string key, string text)
    {
        var rows = text.Split('\n').Sum(line => 1 + line.Length / 110);
        return Math.Clamp(rows, 1, key == "canonicalText" ? 40 : 12);
    }
}
