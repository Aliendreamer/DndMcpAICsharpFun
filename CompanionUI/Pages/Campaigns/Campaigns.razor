@page "/campaigns"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@using DndMcpAICsharpFun.Domain
@using DndMcpAICsharpFun.Features.Campaigns
@using DndMcpAICsharpFun.Features.Lore
@using DndMcpAICsharpFun.Features.Retrieval
@attribute [Authorize]
@inject CampaignRepository CampaignRepo
@inject NavigationManager Nav
@inject AuthenticationStateProvider Auth

<PageTitle>Campaigns</PageTitle>

<div class="campaigns-page">
    <h1>My Campaigns</h1>

    @if (_campaigns is null)
    {
        <p>Loading...</p>
    }
    else if (_campaigns.Count == 0 && !_showCreateForm)
    {
        <p>No campaigns yet. Create your first one!</p>
    }
    else
    {
        <div class="campaign-grid">
            @foreach (var c in _campaigns)
            {
                <div class="campaign-card">
                    <div class="campaign-card-body" @onclick="() => GoToCampaign(c.Id)">
                        <h3>@c.Name</h3>
                        @if (!string.IsNullOrEmpty(c.Description))
                        {
                            <p>@c.Description</p>
                        }
                        <small>@c.HeroCount hero@(c.HeroCount == 1 ? "" : "es") · @c.CreatedAt.ToString("yyyy-MM-dd")</small>
                    </div>
                    <div class="campaign-card-actions">
                        @if (_deleteConfirmId == c.Id)
                        {
                            <button class="btn-danger" @onclick="() => ConfirmDeleteAsync(c.Id)">Confirm</button>
                            <button @onclick="() => _deleteConfirmId = null">Cancel</button>
                        }
                        else
                        {
                            <button @onclick="() => _deleteConfirmId = c.Id">Delete</button>
                        }
                    </div>
                </div>
            }
        </div>
    }

    @if (_showCreateForm)
    {
        <div class="create-form">
            <h3>New Campaign</h3>
            <label>Name <input @bind="_newName" placeholder="e.g. Curse of Strahd" /></label>
            <label>Description <input @bind="_newDescription" placeholder="Optional" /></label>
            <label>Setting
                <select @bind="_newSetting">
                    <option value="">Generic / none</option>
                    @foreach (var s in SettingCatalog.KnownSettings)
                    {
                        <option value="@s">@s</option>
                    }
                </select>
            </label>
            <label>Edition
                <select value="@_newEdition" @onchange="OnEditionChanged">
                    <option value="@(DndVersion.Edition2014)">2014</option>
                    <option value="@(DndVersion.Edition2024)">2024</option>
                </select>
            </label>
            <div class="book-select">
                <span class="book-select-heading">Source Books</span>
                <div class="book-select-groups">
                    <div class="book-group">
                        <h4 class="book-group-title">2024</h4>
                        @foreach (var b in BookCatalog.All.Where(x => x.Version == DndVersion.Edition2024))
                        {
                            <label class="checkbox-label">
                                <input type="checkbox" checked="@_newBookKeys.Contains(b.Key)"
                                       @onchange="e => ToggleNewBook(b.Key, e)" />
                                @b.DisplayName
                            </label>
                        }
                    </div>
                    <div class="book-group">
                        <h4 class="book-group-title">2014</h4>
                        @foreach (var b in BookCatalog.All.Where(x => x.Version == DndVersion.Edition2014))
                        {
                            <label class="checkbox-label">
                                <input type="checkbox" checked="@_newBookKeys.Contains(b.Key)"
                                       @onchange="e => ToggleNewBook(b.Key, e)" />
                                @b.DisplayName
                            </label>
                        }
                    </div>
                </div>
            </div>
            <p class="muted">Rules from: @CampaignScopeDisplay.Mechanics(NewScope) · Lore from: @CampaignScopeDisplay.Lore(NewScope)</p>
            @if (NewScope.MechanicsScope.Count == 0)
            {
                <p class="error">No rulebooks for this edition are selected — rules answers will have nothing to draw on.</p>
            }
            @if (!string.IsNullOrEmpty(_createError))
            {
                <p class="error">@_createError</p>
            }
            <div class="form-actions">
                <button @onclick="CreateAsync">Create</button>
                <button @onclick="CancelCreate">Cancel</button>
            </div>
        </div>
    }
    else
    {
        <button class="btn-primary" @onclick="() => _showCreateForm = true">+ New Campaign</button>
    }
</div>

@code {
    private List<CampaignSummary>? _campaigns;
    private long _userId;
    private bool _showCreateForm;
    private string _newName = "";
    private string _newDescription = "";
    private string _newSetting = "";
    private DndVersion _newEdition = DndVersion.Edition2014;
    private HashSet<string> _newBookKeys = CampaignScopeResolver.CoreBooksFor(DndVersion.Edition2014).ToHashSet();
    private string _createError = "";
    private long? _deleteConfirmId;

    protected override async Task OnInitializedAsync()
    {
        var state = await Auth.GetAuthenticationStateAsync();
        _userId = long.Parse(state.User.FindFirst(ClaimTypes.NameIdentifier)!.Value);
        await LoadAsync();
    }

    private void GoToCampaign(long id) => Nav.NavigateTo($"/campaigns/{id}");

    private void CancelCreate()
    {
        _showCreateForm = false;
        _createError = "";
    }

    private async Task LoadAsync()
    {
        _campaigns = await CampaignRepo.GetAllAsync(_userId);
    }

    // Re-seeds the book selection to the new edition's core rulebooks. Safe because nothing is lost
    // before the campaign exists yet — mirrors CampaignRepository.CreateAsync's own core-only default.
    private void OnEditionChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<DndVersion>(e.Value as string, out var edition))
        {
            _newEdition = edition;
            _newBookKeys = CampaignScopeResolver.CoreBooksFor(edition).ToHashSet();
        }
    }

    // Same derivation as CampaignDetail.razor's Scope, but the campaign doesn't exist yet here — a
    // throwaway Campaign built from the form fields, never a duplicated mechanics ∩ edition rule.
    private CampaignScope NewScope => CampaignScopeResolver.Resolve(
        new Campaign(0, _userId, "", "", DateTime.UtcNow, null, _newEdition, _newBookKeys.ToList()));

    private void ToggleNewBook(string key, ChangeEventArgs e)
    {
        var isChecked = e.Value is bool b && b;
        if (isChecked)
        {
            _newBookKeys.Add(key);
        }
        else
        {
            _newBookKeys.Remove(key);
        }
    }

    private async Task CreateAsync()
    {
        if (string.IsNullOrWhiteSpace(_newName))
        {
            _createError = "Name is required.";
            return;
        }
        try
        {
            await CampaignRepo.CreateAsync(_userId, _newName.Trim(), _newDescription.Trim(),
                string.IsNullOrWhiteSpace(_newSetting) ? null : _newSetting,
                _newEdition, _newBookKeys.ToList());
        }
        catch (ArgumentException ex)
        {
            _createError = ex.Message;
            return;
        }
        _newName = "";
        _newDescription = "";
        _newSetting = "";
        _newEdition = DndVersion.Edition2014;
        _newBookKeys = CampaignScopeResolver.CoreBooksFor(_newEdition).ToHashSet();
        _createError = "";
        _showCreateForm = false;
        await LoadAsync();
    }

    private async Task ConfirmDeleteAsync(long id)
    {
        await CampaignRepo.DeleteAsync(id, _userId);
        _deleteConfirmId = null;
        await LoadAsync();
    }
}
