@page "/campaigns/{Id:long}"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@using DndMcpAICsharpFun.Domain
@using DndMcpAICsharpFun.Features.Campaigns
@using DndMcpAICsharpFun.Features.Lore
@using DndMcpAICsharpFun.Features.Retrieval
@attribute [Authorize]
@inject CampaignRepository CampaignRepo
@inject HeroRepository HeroRepo
@inject NoteRepository NoteRepo
@inject NavigationManager Nav
@inject AuthenticationStateProvider Auth

<PageTitle>@(_campaign?.Name ?? "Campaign")</PageTitle>

@if (_campaign is null)
{
    <p>Loading...</p>
}
else
{
    <div class="campaign-detail">
        <nav><a href="/campaigns">← Campaigns</a></nav>
        <h1>@_campaign.Name</h1>
        @if (!string.IsNullOrEmpty(_campaign.Description))
        {
            <p class="campaign-desc">@_campaign.Description</p>
        }

        <label class="campaign-setting">Setting
            <select value="@(_campaign.Setting ?? "")" @onchange="OnSettingChangedAsync">
                <option value="">Generic / none</option>
                @foreach (var s in SettingCatalog.KnownSettings)
                {
                    <option value="@s">@s</option>
                }
            </select>
        </label>

        <label class="campaign-setting">Edition
            <select value="@_edition" @onchange="OnEditionChangedAsync">
                <option value="@(DndVersion.Edition2014)">2014</option>
                <option value="@(DndVersion.Edition2024)">2024</option>
            </select>
        </label>

        @if (!string.IsNullOrEmpty(_booksError))
        {
            <p class="error">@_booksError</p>
        }

        <div class="book-select">
            <h2 class="book-select-heading">Source Books</h2>
            <div class="book-select-groups">
                <div class="book-group">
                    <h3 class="book-group-title">2024</h3>
                    @foreach (var b in BookCatalog.All.Where(x => x.Version == DndVersion.Edition2024))
                    {
                        <label class="checkbox-label">
                            <input type="checkbox" checked="@_bookKeys.Contains(b.Key)"
                                   @onchange="e => OnBookToggledAsync(b.Key, e)" />
                            @b.DisplayName
                        </label>
                    }
                </div>
                <div class="book-group">
                    <h3 class="book-group-title">2014</h3>
                    @foreach (var b in BookCatalog.All.Where(x => x.Version == DndVersion.Edition2014))
                    {
                        <label class="checkbox-label">
                            <input type="checkbox" checked="@_bookKeys.Contains(b.Key)"
                                   @onchange="e => OnBookToggledAsync(b.Key, e)" />
                            @b.DisplayName
                        </label>
                    }
                </div>
            </div>
        </div>

        <p class="muted">Rules from: @CampaignScopeDisplay.Mechanics(Scope) · Lore from: @CampaignScopeDisplay.Lore(Scope)</p>
        @if (Scope.MechanicsScope.Count == 0)
        {
            <p class="error">No rulebooks for this edition are selected — rules answers will have nothing to draw on.</p>
        }

        <h2>Party</h2>
        <div class="hero-roster">
            @foreach (var hero in _heroes)
            {
                var sheet = hero.LatestSnapshot?.Sheet;
                <div class="hero-card" @onclick="() => GoToHero(hero.Id)">
                    <strong>@hero.Name</strong>
                    @if (sheet is not null)
                    {
                        <span>@sheet.Class @(string.IsNullOrEmpty(sheet.Subclass) ? "" : $"({sheet.Subclass})") · Lv @sheet.Level</span>
                        <span class="data">HP @sheet.CurrentHitPoints / @sheet.MaxHitPoints · AC @sheet.ArmorClass</span>
                    }
                </div>
            }
        </div>

        @if (_showAddHero)
        {
            <div class="add-hero-form">
                <input @bind="_newHeroName" placeholder="Hero name" />
                @if (!string.IsNullOrEmpty(_addHeroError))
                {
                    <p class="error">@_addHeroError</p>
                }
                <button @onclick="AddHeroAsync">Add</button>
                <button @onclick="CancelAddHero">Cancel</button>
            </div>
        }
        else
        {
            <button @onclick="ShowAddHero">+ Add Hero</button>
        }

        <p class="run-session"><a class="button" href="/campaigns/@Id/table">▶ Run session</a></p>

        <h2>Notes</h2>
        <div class="notes-list">
            @foreach (var note in _notes)
            {
                <div class="note-card">
                    @if (_editingNoteId == note.Id)
                    {
                        <input @bind="_editTitle" placeholder="Title" />
                        <textarea @bind="_editContent" placeholder="Write a note..." rows="3"></textarea>
                        @if (!string.IsNullOrEmpty(_editNoteError))
                        {
                            <p class="error">@_editNoteError</p>
                        }
                        <button @onclick="() => SaveNoteEditAsync(note.Id)">Save</button>
                        <button @onclick="CancelEditNote">Cancel</button>
                    }
                    else
                    {
                        <div class="note-head">
                            <strong>@note.Title</strong>
                            <span class="note-actions">
                                <button class="note-edit" title="Edit" @onclick="() => BeginEditNote(note)">✎</button>
                                <button class="note-del" title="Delete" @onclick="() => DeleteNoteAsync(note.Id)">✕</button>
                            </span>
                        </div>
                        <p class="note-body">@note.Content</p>
                        <span class="note-time">@note.UpdatedAt.ToString("yyyy-MM-dd HH:mm")</span>
                    }
                </div>
            }
            @if (_notes.Count == 0)
            {
                <p class="muted">No notes yet.</p>
            }
        </div>

        @if (_showAddNote)
        {
            <div class="add-note-form">
                <input @bind="_noteTitle" placeholder="Title" />
                <textarea @bind="_noteContent" placeholder="Write a note..." rows="3"></textarea>
                @if (!string.IsNullOrEmpty(_addNoteError))
                {
                    <p class="error">@_addNoteError</p>
                }
                <button @onclick="AddNoteAsync">Save</button>
                <button @onclick="CancelAddNote">Cancel</button>
            </div>
        }
        else
        {
            <button @onclick="() => _showAddNote = true">+ Add Note</button>
        }
    </div>
}

@code {
    [Parameter] public long Id { get; set; }

    private Campaign? _campaign;
    private List<Hero> _heroes = [];
    private long _userId;
    private DndVersion _edition;
    private HashSet<string> _bookKeys = [];
    private string _booksError = "";
    private bool _showAddHero;
    private string _newHeroName = "";
    private string _addHeroError = "";

    private List<Note> _notes = [];
    private bool _showAddNote;
    private string _noteTitle = "";
    private string _noteContent = "";
    private string _addNoteError = "";

    private long? _editingNoteId;
    private string _editTitle = "";
    private string _editContent = "";
    private string _editNoteError = "";

    protected override async Task OnInitializedAsync()
    {
        var state = await Auth.GetAuthenticationStateAsync();
        _userId = long.Parse(state.User.FindFirst(ClaimTypes.NameIdentifier)!.Value);
        _campaign = await CampaignRepo.GetByIdAsync(Id, _userId);
        if (_campaign is null)
        {
            Nav.NavigateTo("/campaigns");
            return;
        }
        _edition = _campaign.Edition;
        _bookKeys = _campaign.AllowedBookKeys.ToHashSet();
        _heroes = await HeroRepo.GetByCampaignAsync(Id);
        _notes = await NoteRepo.GetByCampaignAsync(Id);
    }

    private void GoToHero(long heroId) => Nav.NavigateTo($"/campaigns/{Id}/heroes/{heroId}");

    private async Task OnSettingChangedAsync(ChangeEventArgs e)
    {
        var value = e.Value as string;
        await CampaignRepo.SetSettingAsync(Id, _userId, string.IsNullOrWhiteSpace(value) ? null : value);
        _campaign = await CampaignRepo.GetByIdAsync(Id, _userId);
    }

    // Edition and the book allowlist are independent by design (see Campaign.cs): changing the
    // edition here does NOT re-seed the selected books, unlike the create form. This campaign may
    // already be using supplements a silent reseed would drop from underneath a live table.
    private async Task OnEditionChangedAsync(ChangeEventArgs e)
    {
        if (Enum.TryParse<DndVersion>(e.Value as string, out var edition))
        {
            _edition = edition;
            await PersistBooksAsync();
        }
    }

    private async Task OnBookToggledAsync(string key, ChangeEventArgs e)
    {
        var isChecked = e.Value is bool b && b;
        if (isChecked)
        {
            _bookKeys.Add(key);
        }
        else
        {
            _bookKeys.Remove(key);
        }
        await PersistBooksAsync();
    }

    private async Task PersistBooksAsync()
    {
        try
        {
            await CampaignRepo.SetBooksAsync(Id, _userId, _edition, _bookKeys.ToList());
            _campaign = await CampaignRepo.GetByIdAsync(Id, _userId);
            _booksError = "";
        }
        catch (ArgumentException ex)
        {
            _booksError = ex.Message;
            // Revert to _campaign — the last state actually persisted — so the checkboxes/edition
            // selector never display something the database does not have. _campaign is only ever
            // reassigned on a successful persist above, so it still holds that last-good state here.
            _edition = _campaign!.Edition;
            _bookKeys = _campaign.AllowedBookKeys.ToHashSet();
        }
    }

    // Derives the effective scope from the CURRENT (possibly not-yet-persisted) form state, so the
    // summary can never disagree with the checkboxes even mid-edit. No new dependency: pure function
    // over a throwaway Campaign built from the form fields, per CampaignScopeResolver's own contract.
    private CampaignScope Scope => CampaignScopeResolver.Resolve(
        new Campaign(0, _userId, "", "", DateTime.UtcNow, null, _edition, _bookKeys.ToList()));

    private void ShowAddHero() => _showAddHero = true;
    private void CancelAddHero() { _showAddHero = false; _addHeroError = ""; }

    private async Task AddHeroAsync()
    {
        if (string.IsNullOrWhiteSpace(_newHeroName))
        {
            _addHeroError = "Name is required.";
            return;
        }
        var heroId = await HeroRepo.CreateAsync(Id, _newHeroName.Trim());
        Nav.NavigateTo($"/campaigns/{Id}/heroes/{heroId}");
    }

    private void CancelAddNote() { _showAddNote = false; _noteTitle = ""; _noteContent = ""; _addNoteError = ""; }

    private async Task AddNoteAsync()
    {
        if (string.IsNullOrWhiteSpace(_noteTitle))
        {
            _addNoteError = "Title is required.";
            return;
        }
        await NoteRepo.CreateAsync(_userId, Id, _noteTitle.Trim(), _noteContent.Trim());
        _notes = await NoteRepo.GetByCampaignAsync(Id);
        CancelAddNote();
    }

    private async Task DeleteNoteAsync(long noteId)
    {
        await NoteRepo.DeleteAsync(noteId, Id);
        _notes = await NoteRepo.GetByCampaignAsync(Id);
    }

    private void BeginEditNote(Note note)
    {
        _editingNoteId = note.Id;
        _editTitle = note.Title;
        _editContent = note.Content;
        _editNoteError = "";
    }

    private void CancelEditNote()
    {
        _editingNoteId = null;
        _editTitle = "";
        _editContent = "";
        _editNoteError = "";
    }

    private async Task SaveNoteEditAsync(long noteId)
    {
        if (string.IsNullOrWhiteSpace(_editTitle))
        {
            _editNoteError = "Title is required.";
            return;
        }
        await NoteRepo.UpdateAsync(noteId, Id, _editTitle.Trim(), _editContent.Trim());
        _notes = await NoteRepo.GetByCampaignAsync(Id);
        CancelEditNote();
    }
}
