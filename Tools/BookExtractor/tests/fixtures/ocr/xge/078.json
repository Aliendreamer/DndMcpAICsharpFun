]], "t": "who keeps it all going, and this chapter is", "s": 0.99967}, {"box": [[814.5833740234375, 491.2298583984375], [1388.9974365234375, 487.9032287597656], [1388.9974365234375, 523.3870849609375], [814.5833740234375, 526.7137451171875]], "t": "FlyIng CreatureS And FalLInG", "s": 0.72488}, {"box": [[277.79949951171875, 503.42742919921875], [738.2161865234375, 502.31854248046875], [738.2161865234375, 535.5846557617188], [277.79949951171875, 536.6935424804688]], "t": "for you. It gives you new rules options, as", "s": 0.99269}, {"box": [[276.6927185058594, 537.8024291992188], [749.2838745117188, 532.258056640625], [749.2838745117188, 561.0887451171875], [276.6927185058594, 566.633056640625]], "t": "well as some refined tools for creating and", "s": 0.99882}, {"box": [[814.5833740234375, 541.1290283203125], [1414.453125, 536.6935424804688], [1414.453125, 566.633056640625], [814.5833740234375, 571.0685424804688]], "t": "A flying creature in flight falls if it is knocked prone, if", "s": 0.96467}, {"box": [[276.6927185058594, 567.741943359375], [749.2838745117188, 563.3064575195312], [749.2838745117188, 592.1370849609375], [276.6927185058594, 596.5725708007812]], "t": "running adventures and campaigns. It is a", "s": 0.9998}, {"box": [[815.6901245117188, 574.3951416015625], [1432.1614990234375, 568.850830078125], [1432.1614990234375, 594.3548583984375], [815.6901245117188, 599.8992309570312]], "t": "its speed is reduced to O feet, or if it otherwise loses the", "s": 0.9748}, {"box": [[277.79949951171875, 598.7903442382812], [747.0703125, 594.3548583984375], [747.0703125, 620.9677734375], [277.79949951171875, 625.4032592773438]], "t": "supplement to the tools and advice offered", "s": 0.98363}, {"box": [[814.5833740234375, 602.116943359375], [1398.9583740234375, 597.6814575195312], [1398.9583740234375, 627.6209716796875], [814.5833740234375, 632.0564575195312]], "t": "ability to move, unless it can hover or it is being held", "s": 0.97397}, {"box": [[121.7447967529296