": 0.99627}, {"box": [[129.38450622558594, 1265.818603515625], [712.1494750976562, 1265.818603515625], [712.1494750976562, 1297.2742919921875], [129.38450622558594, 1297.2742919921875]], "t": "It is said that if he had his way, the Crying God would", "s": 0.98614}, {"box": [[804.1087036132812, 1269.0726318359375], [1254.28125, 1269.0726318359375], [1254.28125, 1294.020263671875], [804.1087036132812, 1294.020263671875]], "t": "stature and became a scribe of the dead.", "s": 0.99036}, {"box": [[110.1372299194336, 1297.2742919921875], [706.802978515625, 1297.2742919921875], [706.802978515625, 1325.475830078125], [110.1372299194336, 1325.475830078125]], "t": "take all the suffering in the world onto himself, so as to", "s": 0.99688}, {"box": [[822.2866821289062, 1297.2742919921875], [1383.665771484375, 1297.2742919921875], [1383.665771484375, 1325.475830078125], [822.2866821289062, 1325.475830078125]], "t": "Jergal is now seen as an uncaring custodian of the", "s": 0.99869}, {"box": [[109.06793975830078, 1328.7298583984375], [738.8818359375, 1327.645263671875], [738.8818359375, 1355.8468017578125], [109.06793975830078, 1356.9315185546875]], "t": "spare others. Since he can't, he blesses those who endure", "s": 0.99178}, {"box": [[801.9701538085938, 1327.645263671875], [1400.7745361328125, 1327.645263671875], [1400.7745361328125, 1359.100830078125], [801.9701538085938, 1359.100830078125]], "t": "dead. He is thought to record the passing of the living", "s": 0.97026}, {"box": [[110.1372299194336, 1356.9315185546875], [738.8818359375, 1358.0162353515625], [738.8818359375, 1386.2177734375], [110.1372299194336, 1385.133056640625]], "t": "on others' behalf, and he alleviates suffering when he can.", "s": 0.99602}, {"box": [[803.0394287109375, 1358.0162353515625], [1390.08154296875, 1360.185546875], [1390.08154296875, 1388.38720703125], [803.0394287109375, 1386.2177734375]], "t": "and to aid Kelemvor in seeing that souls are properly", "s": 0.99012}, {"box": [[110.137229919433