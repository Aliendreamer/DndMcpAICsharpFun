], [768.8302001953125, 1772.7021484375], [768.8302001953125, 1802.192626953125], [151.37025451660156, 1797.8236083984375]], "t": "help others. Other dwarves are driven by the command", "s": 0.9891}, {"box": [[149.1922607421875, 1800.0081787109375], [720.9144287109375, 1803.284912109375], [720.9144287109375, 1831.6829833984375], [149.1922607421875, 1828.4063720703125]], "t": "or inspiration of a deity, a direct calling or simply a", "s": 0.97422}, {"box": [[149.1922607421875, 1829.49853515625], [768.8302001953125, 1831.6829833984375], [768.8302001953125, 1864.4501953125], [149.1922607421875, 1862.2657470703125]], "t": "desire to bring glory to one of the dwarf gods. Clan and", "s": 0.9917}, {"box": [[148.103271484375, 1862.2657470703125], [760.1182250976562, 1864.4501953125], [760.1182250976562, 1893.9405517578125], [148.103271484375, 1891.756103515625]], "t": "ancestry are also important motivators. A dwarf might", "s": 0.9938}, {"box": [[149.1922607421875, 1892.848388671875], [738.33837890625, 1896.1251220703125], [738.33837890625, 1925.615478515625], [149.1922607421875, 1922.3387451171875]], "t": "seek to restore a clan's lost honor, avenge an ancient", "s": 0.98014}, {"box": [[149.1922607421875, 1924.5233154296875], [767.7412109375, 1925.615478515625], [767.7412109375, 1954.013671875], [149.1922607421875, 1952.9215087890625]], "t": "wrong the clan suffered, or earn a new place within the", "s": 0.9956}, {"box": [[149.1922607421875, 1952.9215087890625], [760.1182250976562, 1957.2904052734375], [760.1182250976562, 1985.6885986328125], [149.1922607421875, 1981.319580078125]], "t": "clan after having been exiled. Or a dwarf might search", "s": 0.98786}, {"box": [[148.103271484375, 1982.411865234375], [785.1651000976562, 1984.5963134765625], [785.1651000976562, 2017.363525390625], [148.103271484375, 2015.1790771484375]], "t": "for the axe wielded by a mighty ancestor, lost on the field", "s": 0.9828}, {"box": [[149.1922607421875, 2014.0867919921875], [408.372985839843