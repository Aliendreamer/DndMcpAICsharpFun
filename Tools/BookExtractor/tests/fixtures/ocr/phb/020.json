[860.3057250976562, 879.2515258789062], [1462.519775390625, 881.43603515625], [1462.519775390625, 909.834228515625], [860.3057250976562, 907.6497192382812]], "t": "but certainly points to how difficult it can be for a member of", "s": 0.9881}, {"box": [[152.45924377441406, 902.1885375976562], [551.03125, 905.4652709960938], [551.03125, 941.5090942382812], [152.45924377441406, 938.232421875]], "t": "CLANS AND KiNGDOMS", "s": 0.80463}, {"box": [[860.3057250976562, 908.741943359375], [1383.023193359375, 909.834228515625], [1383.023193359375, 936.0479125976562], [860.3057250976562, 934.9556884765625]], "t": "a short-lived race like humans to earn a dwarf's trust.", "s": 0.98837}, {"box": [[882.0856323242188, 936.0479125976562], [1464.69775390625, 938.232421875], [1464.69775390625, 966.630615234375], [882.0856323242188, 964.4461059570312]], "t": "Elves. \"It's not wise to depend on the elves. No telling what", "s": 0.98378}, {"box": [[151.37025451660156, 954.615966796875], [782.9871215820312, 956.8004150390625], [782.9871215820312, 985.1986083984375], [151.37025451660156, 983.01416015625]], "t": "Dwarven kingdoms stretch deep beneath the mountains", "s": 0.9831}, {"box": [[860.3057250976562, 964.4461059570312], [1438.5618896484375, 965.538330078125], [1438.5618896484375, 993.9365234375], [860.3057250976562, 992.8442993164062]], "t": "an elf will do next; when the hammer meets the orc's head.", "s": 0.98842}, {"box": [[151.37025451660156, 986.2908935546875], [727.4484252929688, 987.3831176757812], [727.4484252929688, 1016.87353515625], [151.37025451660156, 1015.7813110351562]], "t": "where the dwarves mine gems and precious metals", "s": 0.98735}, {"box": [[860.3057250976562, 992.8442993164062], [1450.5408935546875, 993.9365234375], [1450.5408935546875, 1023.4269409179688], [860.3057250976562, 1022.334716796875]], "t": "they're as apt to start singing as to pull out a sword. They're", "s": 0.96969}, {"box": [[151.37025451660156, 1016.87353515625], [731.8043823242188, 1019.0579833984375], [731.8043823242188, 1047.4561767578125], [151.37025451660156, 1045.271728515625]], "t": "and forge items of wonder. They love the beauty and", "s": 0.99597}, {"box": [[860.3057250976562, 1021.2424926757812], [1458.163818359375, 1023.4269409179688], [1458.163818359375, 1051.8251953125], [860.3057250976562, 1049.640625]], "t": "flighty and frivolous. Two things to be said for them, though:", "s": 0.99368}, {"box": [[151.37025451660156, 1049.640625], [779.7201538085938, 1050.73291015625], [779.7201538085938, 1076.9466552734375], [151.37025451660156, 1075.8543701171875]], "t": "artistry of precious metals and fine jewelry, and in some", "s": 0.9879}, {"box": [[861.394775390625, 1048.5484619140625], [1461.4307861328125, 1051.8251953125], [1461.4307861328125, 1081.3155517578125], [861.394775390625, 1078.038818359375]], "t": "They don't have many smiths, but the ones they have do very", "s": 0.98954}, {"box": [[151.37025451660156, 1079.131103515625], [767.7412109375, 1080.223388671875], [767.7412109375, 1108.6214599609375], [151.37025451660156, 1107.529296875]], "t": "dwarves this love festers into avarice. Whatever wealth", "s": 0.98791}, {"box": [[860.3057250976562, 1076.9466552734375], [1442.9178466796875, 1079.131103515625], [1442.9178466796875, 1107.529296875], [860.3057250976562, 1105.3448486328125]], "t": "fine work. And when orcs or goblins come streaming down", "s": 0.996}, {"box": [[151.37025451660156, 1109.7137451171875], [732.8933715820312, 1111.898193359375], [732.8933715820312, 1141.388671875], [151.37025451660156, 1139.2042236328125]], "t": "they can't find in their mountains, they gain through", "s": 0.99969}, {"box": [[860.3057250976562, 1105.3448486328125], [1464.69775390625, 1106.43701171875], [1464.69775390625, 1135.927490234375], [860.3057250976562, 1134.835205078125]], "t": "out of the mountains, an elf's good to have at your back. Not", "s": 0.99203}, {"box": [[149.1922607421875, 1139.2042236328125], [756.8512573242188, 1141.388671875], [756.8512573242188, 1174.15576171875], [149.1922607421875, 1171.9713134765625]], "t": "trade. They dislike boats, so enterprising humans and", "s": 0.99122}, {"box": [[861.394775390625, 1134.835205078125], [1445.0958251953125, 1134.835205078125], [1445.0958251953125, 1163.2333984375], [861.394775390625, 1163.2333984375]], "t": "as good as a dwarf, maybe, but no doubt they hate the orcs", "s": 0.99319}, {"box": [[151.37025451660156, 1171.9713134765625], [723.0924072265625, 1174.15576171875], [723.0924072265625, 1203.646240234375], [151.37025451660156, 1201.4617919921875]], "t": "halflings frequently handle trade in dwarven goods", "s": 0.99876}, {"box": [[860.3057250976562, 1164.32568359375], [1054.1468505859375, 1162.1412353515625], [1054.1468505859375, 1188.3548583984375], [860.3057250976562, 1190.539306640625]], "t": "as much as we do.\"", "s": 0.99912}, {"box": [[883.1746215820312, 1189.4471435546875], [1405.89208984375, 1191.631591796875], [1405.89208984375, 1220.02978515625], [883.1746215820312, 1217.8453369140625]], "t": "Halflings. \"Sure, they're pleasant folk. But show me a", "s": 0.97221}, {"box": [[151.37025451660156, 1204.7384033203125], [786.2540893554688, 1205.8306884765625], [786.2540893554688, 1232.04443359375], [151.37025451660156, 1230.9521484375]], "t": "along water routes. Trustworthy members of other races", "s": 0.98367}, {"box": [[860.3057250976562, 1216.7530517578125], [1458.163818359375, 1221.1220703125], [1458.163818359375, 1250.6124267578125], [860.3057250976562, 1246.2435302734375]], "t": "halfling hero. An empire, a triumphant army. Even a treasure", "s": 0.9943}, {"box": [[149.1922607421875, 1234.2288818359375], [759.0292358398438, 1236.413330078125], [759.0292358398438, 1264.8115234375], [149.1922607421875, 1262.6270751953125]], "t": "are welcome in dwarf settlements, though some areas", "s": 0.98165}, {"box": [[860.3057250976562, 1245.1512451171875], [1448.36279296875, 1249.520263671875], [1448.36279296875, 1279.0106201171875], [860.3057250976562, 1274.6417236328125]], "t": "for the ages made by halfling hands. Nothing. How can you", "s": 0.99003}, {"box": [[151.37025451660156, 1268.0882568359375], [450.8437805175781, 1268.0882568359375], [450.8437805175781, 1293.209716796875], [151.37025451660156, 1293.209716796875]], "t": "are off limits even to them.", "s": 0.98798}, {"box": [[862.4837646484375, 1276.826171875], [1074.837646484375, 1276.826171875], [1074.837646484375, 1301.9476318359375], [862.4837646484375, 1301.9476318359375]], "t": "take them seriously?\"", "s": 0.97877}, {"box": [[173.150146484375, 1295.3941650390625], [720.9144287109375, 1296.4864501953125], [720.9144287109375, 1324.8846435546875], [173.150146484375, 1323.7923583984375]], "t": "The chief unit of dwarven society is the clan, and", "s": 0.99389}, {"box": [[880.9966430664062, 1301.9476318359375], [1449.4517822265625, 1303.0399169921875], [1449.4517822265625, 1332.5302734375], [880.9966430664062, 1331.4381103515625]], "t": "Humans. \"You take the time to get to know a human, and", "s": 0.98801}, {"box": [[151.37025451660156, 1327.069091796875], [733.9823608398438, 1329.2535400390625], [733.9823608398438, 1356.5595703125], [151.37025451660156, 1354.375]], "t": "dwarves highly value social standing. Even dwarves", "s": 0.9992}, {"box": [[862.4837646484375, 1331.4381103515625], [1436.3839111328125, 1333.62255859375], [1436.3839111328125, 1358.7440185546875], [862.4837646484375, 1356.5595703125]], "t": "by then the human's on her deathbed. If you're lucky, she's", "s": 0.98933}, {"box": [[150.28126525878906, 1357.6517333984375], [776.4531860351562, 1358.7440185546875], [776.4531860351562, 1387.1422119140625], [150.28126525878906, 1386.0499267578125]], "t": "who live far from their own kingdoms cherish their clan", "s": 0.98238}, {"box": [[860.3057250976562, 1358.7440185546875], [1432.0279541015625, 1360.928466796875], [1432.0279541015625, 1389.32666015625], [860.3057250976562, 1387.1422119140625]], "t": "got kin\u2014a daugh